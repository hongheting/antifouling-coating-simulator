.rmap { position: relative; border-radius: 16rpx; overflow: hidden; background: #061820; border: 1rpx solid rgba(64, 200, 200, .25); box-shadow: 0 0 24rpx rgba(20, 160, 180, .18); }
.cv { width: 100%; height: 188px; display: block; }
.note { padding: 10rpx 14rpx 14rpx; font-size: 20rpx; color: #7aa8b8; line-height: 1.4; background: linear-gradient(180deg, transparent, rgba(6,24,32,.92)); }
