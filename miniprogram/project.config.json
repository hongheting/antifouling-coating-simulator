{
  "description": "防污涂料配方模拟器 · 工具版（微信小程序，原生）",
  "appid": "touristappid",
  "projectname": "antifouling-coating-simulator-mp",
  "compileType": "miniprogram",
  "miniprogramRoot": "",
  "libVersion": "3.4.0",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "test"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      },
      {
        "type": "file",
        "value": ".gitignore"
      }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXML": true,
    "minifyWXSS": true,
    "uploadWithSourceMap": true,
    "ignoreUploadUnusedFiles": true
  },
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
