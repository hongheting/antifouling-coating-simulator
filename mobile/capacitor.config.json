{
  "appId": "com.hongheting.coatingsimulator",
  "appName": "防污涂料配方模拟器",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0b1017",
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 10000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true,
      "version": "0.6.0+2"
    }
  }
}