{
  "name": "coating-simulator",
  "productName": "防污涂料配方模拟器",
  "version": "0.6.0",
  "description": "Antifouling coating formulation simulator (desktop, same UI as mobile 0.6.0). Simulation ≠ measurement. Signed (Ed25519) OTA UI updates only.",
  "main": "main.js",
  "author": "Hong Heting <heting@localhost>",
  "homepage": "https://github.com/hongheting/antifouling-coating-simulator",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "npm run sync-ui && electron-builder --win --x64",
    "dist:linux": "electron-builder --linux",
    "sync-ui": "node scripts/sync-ui.js",
    "test": "node --test test/"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
